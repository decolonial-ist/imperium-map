# Рабочая кухня: хендоффы, таски, отчёты, журнал проекта. Лежит локально,
# в публичный репо НЕ уходит (втык куратора 30.08.2026).
/README.md
/HANDOFF*.md
/CHECK_HANDOFF*.md
/NIGHT_REPORT*.md
/REVIEW_*.md
/TASK_*.md
# локальная страница для проверки встройки в iframe (кухня)
/_embed_demo_local.html

# data/deepstate/days/ (242 МБ, ~1500 файлов) НУЖНЫ в гите: карта тянет их
# на лету (index.html, DFETCH 'data/deepstate/days/...'), без них на GitHub
# Pages отваливается вся война 2022+. Из игнора убраны 29.08.2026.

# Скачанные сканы карт и договоров (~490 МБ): в гит не кладём, они
# воспроизводимы — URL каждого записан в data/sources/registry.json
# и в README.txt внутри папок. Текст, описи и выписки границ остаются.
data/sources/**/*.pdf
data/sources/**/*.png
data/sources/**/*.jpg
data/sources/**/*.jpeg
data/sources/**/*.gif
data/sources/**/*.djvu
data/sources/**/*.tif
data/sources/**/*.tiff

# Заявки доменов в корне (NOTICE и таблицы) - кухня, в публичный репо не идут (14.09.2026)
/NOTICE_*.md
/*_from_*.csv

# node: инструменты сборки топологии (package.json), в репо не идут
node_modules/
# снимки index.html для сравнения кадров между этапами (кухня)
/_index_*.html

# Кухня сборщика rebuild.py (24.09.2026): состояние для --changed, сырые слои
# войн и снятые срезы. В гит не идёт (решение по архитектуре v3).
/build/

# Полные срезы (2,2 ГБ) сняты с витрины 24.09.2026: крупный масштаб карта берёт
# ячейками data/fine_cells (tools/build_fine_cells.py). На диске срезы лежат для
# сборщиков и чекеров; чистый клон - tools/rebuild.py --all.
/data/years/
