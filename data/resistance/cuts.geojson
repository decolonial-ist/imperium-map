ой","geometry_source":"file:data/ukraine/makhno_region.geojson ∩ ядро на срезе 1919-10-15","approximate":true,"core_key":"1919-10-15","inside_share":0.997},"geometry":{"type":"Polygon","coordinates":[[[36.857,47.198],[36.859,47.189],[36.888,47.171],[36.9,47.174],[36.909,47.165],[36.924,47.17],[36.923,47.16],[36.937,47.166],[36.94,47.157],[36.95,47.159],[36.984,47.124],[37.002,47.128],[37.0,47.114],[37.011,47.111],[37.002,47.101],[37.013,47.089],[36.985,47.08],[37.081,47.047],[37.099,47.059],[37.125,47.039],[37.089,47.007],[37.141,46.982],[37.103,46.96],[37.092,46.968],[37.021,46.928],[37.062,46.884],[37.036,46.871],[36.98,46.86],[36.894,46.803],[36.771,46.754],[36.718,46.78],[36.626,46.782],[36.396,46.717],[36.247,46.638],[36.188,46.67],[35.92,46.657],[35.901,46.721],[35.967,46.724],[35.962,46.746],[36.03,46.755],[36.03,46.78],[36.022,46.78],[36.026,46.809],[36.092,46.822],[36.084,46.85],[36.144,46.872],[36.061,46.894],[36.059,46.887],[35.984,46.869],[35.988,46.905],[36.042,46.905],[36.058,46.918],[36.068,46.985],[35.982,46.976],[35.984,47.022],[35.992,47.029],[35.983,47.053],[36.0,47.059],[36.0,47.069],[35.95,47.06],[35.949,47.069],[35.919,47.068],[35.922,47.043],[35.914,47.028],[35.922,47.026],[35.922,47.011],[35.883,47.007],[35.886,46.992],[35.861,46.99],[35.858,47.005],[35.722,46.996],[35.723,46.99],[35.689,46.987],[35.68,47.045],[35.672,47.043],[35.669,47.064],[35.623,47.102],[35.605,47.105],[35.586,47.095],[35.506,47.101],[35.5,47.114],[35.509,47.127],[35.509,47.144],[35.45,47.159],[35.457,47.17],[35.441,47.174],[35.446,47.185],[35.392,47.202],[35.381,47.179],[35.322,47.203],[35.32,47.174],[35.283,47.176],[35.264,47.139],[35.222,47.134],[35.219,47.147],[35.208,47.146],[35.205,47.155],[35.173,47.152],[35.174,47.119],[35.147,47.116],[35.14,47.09],[35.063,47.092],[35.065,47.083],[35.026,47.079],[34.963,47.078],[34.955,47.141],[34.874,47.133],[34.873,47.145],[34.851,47.142],[34.857,47.154],[34.829,47.172],[34.812,47.16],[34.601,47.134],[34.595,47.163],[34.542,47.1